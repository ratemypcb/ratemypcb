{
  "$id": "https://ratemypcb.com/schemas/report-1.2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvalEligible": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array"
    },
    "bom": {
      "required": [
        "status",
        "lineCount",
        "lines"
      ],
      "type": "object"
    },
    "categories": {
      "type": "array"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "coverage": {
      "type": "array"
    },
    "disclaimer": {
      "type": "string"
    },
    "findings": {
      "type": "array"
    },
    "input": {
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "nativeDrc": {
      "type": "object"
    },
    "profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "profileDrc": {
      "type": [
        "object",
        "null"
      ]
    },
    "reviewScope": {
      "enum": [
        "design",
        "fabrication",
        "assembly",
        "full"
      ]
    },
    "schemaVersion": {
      "const": "1.2"
    },
    "score": {
      "properties": {
        "raw": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "verdict": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "raw",
        "verdict"
      ],
      "type": "object"
    },
    "stackup": {
      "properties": {
        "layerCount": {
          "minimum": 0,
          "type": "integer"
        },
        "layers": {
          "items": {
            "properties": {
              "kind": {
                "enum": [
                  "copper",
                  "dielectric",
                  "core",
                  "prepreg",
                  "mask",
                  "silkscreen",
                  "substrate",
                  "other"
                ]
              },
              "material": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              "thicknessMm": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "kind"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "source": {
          "enum": [
            "kicad",
            "gerber"
          ]
        },
        "thicknessMm": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "source",
        "layerCount",
        "layers"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "tool": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "input",
    "artifacts",
    "score",
    "confidence",
    "coverage",
    "findings",
    "nativeDrc",
    "profileDrc",
    "reviewScope",
    "categories",
    "approvalEligible",
    "profile",
    "bom",
    "stackup",
    "limitations",
    "disclaimer"
  ],
  "title": "RateMyPCB report",
  "type": "object"
}
